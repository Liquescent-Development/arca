# Provenance of the kernel recipe vendored in kernel/recipe/.
#
# This file is DATA, sourced by scripts/build-kernel.sh. Every value here is an
# assertion the build enforces; nothing falls back if an assertion fails.
#
# Where kernel/recipe/ came from
# ------------------------------
# It is a verbatim copy of the kernel/ directory of apple/containerization at
# the commit below, which is the release tag 0.20.1. Every file in
# kernel/recipe/ except image/.dockerignore is byte-identical to that tree; the
# digests are in kernel/recipe.sha256.
#
# That commit is not a guess. The build tree that produced the kernel Arca ships
# survives at ~/.arca/kernel-build/kernel/, and all six upstream files in it are
# byte-identical to this tag. See kernel/README.md for the audit.

UPSTREAM_REPO="https://github.com/apple/containerization.git"
UPSTREAM_COMMIT="452f354bac52ecbfe4a40b729880435a070c5a29"
UPSTREAM_TAG="0.20.1"

# The kernel the recipe builds. KERNEL_SOURCE_URL is kernel/recipe/Makefile's
# KSOURCE (:15); KERNEL_SOURCE_SHA256 is kernel.org's own published sum for it,
# from https://cdn.kernel.org/pub/linux/kernel/v6.x/sha256sums.asc.
KERNEL_VERSION="6.14.9"
KERNEL_SOURCE_URL="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.14.9.tar.xz"
KERNEL_SOURCE_SHA256="390cdde032719925a08427270197ef55db4e90c09d454e9c3554157292c9f361"

# Kernel options Arca requires. Arca does not edit the config to obtain them --
# the vendored config already sets both, and the build asserts they are still
# set rather than silently patching a config it did not expect.
REQUIRED_CONFIGS="CONFIG_TUN=y CONFIG_WIREGUARD=y"
